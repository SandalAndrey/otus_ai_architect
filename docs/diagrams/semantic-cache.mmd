%% Алгоритм семантического кэша с ограничениями нашего проекта.
%% Ключевое отличие от типовой схемы: близость по смыслу не даёт права доступа,
%% поэтому семантическое попадание разрешено только для грифа Public.
%% Разбор - homework/09. Пересборка:
%% npx @mermaid-js/mermaid-cli -i semantic-cache.mmd -o semantic-cache.png -s 3 -b white
flowchart LR

  IN["Запрос: текст, роль,<br/>разрешённые грифы,<br/>идентификатор диалога"]

  G0{"Запрос требует живых данных?<br/>остаток, срок поставки"}
  G1{"Разрешённые грифы<br/>шире, чем Public?"}

  K["Ключ точного кэша:<br/>хеш нормализованного текста<br/>+ набор прав + версия индекса"]
  EX{"Точное совпадение?"}

  EMB["Эмбеддинг вопроса<br/>лёгкой моделью"]
  ANN["Поиск ближайшего<br/>среди вопросов грифа Public<br/>той же версии индекса"]
  TH{"Близость не ниже 0.93?"}

  VER{"Возраст записи<br/>в пределах срока?"}

  HIT["Попадание: ответ из кэша,<br/>живые поля подставляются<br/>запросом в учётную систему"]
  MISS["Промах: генерация<br/>либо очередь"]
  WR["Запись в кэш:<br/>только если ответ прошёл<br/>guardOut и имеет источник"]

  IN --> G0
  G0 -- "да: кэшируется<br/>только текстовая часть" --> K
  G0 -- "нет" --> K
  K --> EX
  EX -- "да" --> VER
  EX -- "нет" --> G1
  G1 -- "да: внутренняя роль" --> MISS
  G1 -- "нет: только Public" --> EMB --> ANN --> TH
  TH -- "да" --> VER
  TH -- "нет" --> MISS
  VER -- "да" --> HIT
  VER -- "нет" --> MISS
  MISS -. "после ответа" .-> WR
  WR -.-> K

  classDef step fill:#eef4fb,stroke:#5b7fa6
  classDef gate fill:#fdf3e0,stroke:#b8863b
  classDef good fill:#e8f2e8,stroke:#5f8a5f
  classDef warn fill:#fbeeee,stroke:#a65b5b
  class IN,K,EMB,ANN,WR step
  class G0,G1,EX,TH,VER gate
  class HIT good
  class MISS warn
