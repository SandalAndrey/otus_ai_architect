%% Слой безопасности: три рубежа против инъекций плюс проверки выхода.
%% Каскад - ADR-0015, рубежи против инъекций - ADR-0018, поток - ADR-0017.
%% Пересборка: npx @mermaid-js/mermaid-cli -i security-layer.mmd -o security-layer.png -s 3 -b white
flowchart TB

  U["Запрос плюс разрешённые грифы<br/>роль разбирает шлюз, не ядро"]
  DOC["Документы поставщиков<br/>прайсы, PDF-каталоги, сканы<br/>недоверенный вход"]

  subgraph GING["ingestionGuard: индексация, бюджета времени нет"]
    direction LR
    I1["Сверка извлечённого текста<br/>с видимым слоем PDF"]
    I2["Правила и близость к кластерам атак<br/>по содержимому чанка"]
    I3["Модель-страж, 300-800 мс<br/>в онлайн не влезает,<br/>здесь время есть"]
  end

  QUAR["Карантин партии:<br/>разбор оператором"]

  subgraph GIN["guardIn: вход, бюджет 300 мс"]
    direction LR
    L1["Уровень 1: правила и словари<br/>менее 5 мс<br/>известные инъекции, PII по формату"]
    PII["PII Sanitizer<br/>Presidio: маскирование до промпта"]
    L2["Уровень 2: близость к кластерам атак<br/>20-50 мс<br/>перефразированные инъекции, уход от темы"]
  end

  CTX["Граница контекста:<br/>фрагменты как данные,<br/>а не как указания"]
  ACL["Извлечение: фильтр по грифу<br/>предикатом запроса, ADR-0002"]
  ST[("Qdrant и Neo4j")]

  LLM["Ядро: агенты и модель<br/>видят только разрешённое,<br/>без ПДн и секретов"]

  subgraph GSTR["Потоковый фильтр: на каждом фрагменте, до отдачи"]
    direction LR
    S1["Разметка ссылок и изображений,<br/>голые адреса, риск R-12"]
    S2["Токсичные конструкции<br/>по словарю, NFR-3.4"]
    S3["ПДн по формату: телефон, почта,<br/>карта. NFR-3.3, независимо от прав"]
  end

  subgraph GOUT["Финальная проверка: на событии done"]
    direction LR
    O1["Утечка атрибутов закрытого грифа<br/>NFR-3.1, второй рубеж после ACL"]
    O2["Ссылка на источник обязательна<br/>NFR-2.4, структурой citations"]
  end

  AUD[("Аудит обращения<br/>12 месяцев, NFR-3.5")]
  ANS["Ответ пользователю<br/>token: только текст<br/>citations: структурой"]
  DENY["Отказ:<br/>fail-closed без исключений"]
  PA["Постаудит: модель-страж<br/>вне бюджета запроса"]

  U --> L1
  L1 -- "прошло" --> PII --> L2
  L1 -. "сработало" .-> DENY
  L2 -- "прошло" --> ACL
  L2 -. "сработало" .-> DENY
  ACL --> ST
  DOC --> I1 --> I2 --> I3
  I1 -. "расхождение слоёв" .-> QUAR
  I2 -. "инъекция" .-> QUAR
  I3 -. "инъекция" .-> QUAR
  I3 -- "чисто" --> ST
  ST --> CTX --> LLM
  LLM -- "фрагменты потока" --> S1
  LLM -- "фрагменты потока" --> S2
  LLM -- "фрагменты потока" --> S3
  S1 -- "очищено" --> ANS
  S2 -- "очищено" --> ANS
  S3 -- "замаскировано" --> ANS
  LLM -- "событие done" --> O1
  LLM -- "событие done" --> O2
  O1 -. "нарушение: поток оборван" .-> DENY
  O2 -. "нет ссылки" .-> DENY
  O1 --> AUD
  O2 --> AUD
  AUD --> ANS
  L2 -. "подозрительно,<br/>но пропущено" .-> PA
  S1 -. "вырезано" .-> PA
  PA -. "новое правило" .-> L1

  classDef step fill:#eef4fb,stroke:#5b7fa6
  classDef sec fill:#fdf3e0,stroke:#b8863b
  classDef store fill:#e8f2e8,stroke:#5f8a5f
  classDef warn fill:#fbeeee,stroke:#a65b5b
  class U,DOC,LLM,ANS,PA step
  class L1,L2,PII,ACL,O1,O2,S1,S2,S3,I1,I2,I3,CTX sec
  class ST,AUD store
  class DENY,QUAR warn
