specification {
  element actor {
    style { shape person color secondary }
  }
  element techActor {
    style { shape person color muted }
  }
  element system {
    style { color primary }
  }
  element external {
    style { color gray }
  }
  element container
  element webapp {
    style { shape browser }
  }
  element storage {
    style { shape storage color green }
  }
  element gpu {
    style { color indigo }
  }
  element component {
    style { shape rectangle color sky }
  }
}

model {
  // Роли, различающиеся уровнем доступа. Разграничение доступа - блокирующий
  // критерий приёмки, поэтому на L1 они показаны раздельно.
  buyer = actor 'Покупатель' {
    description 'Спрашивает о совместимости, отличиях выпусков и наличии. Видит только открытые данные'
  }
  manager = actor 'Менеджер контакт-центра' {
    description 'Отвечает на обращения. Видит остатки и историю заказов'
  }
  procurer = actor 'Закупщик' {
    description 'Сопоставляет прайсы с ассортиментом. Единственный, кто видит закупочные цены и договоры'
  }

  // AI-специфичные роли. Без них на L1 забываются их доступы в контур.
  expert = techActor 'Эксперт-товаровед' {
    description 'Подтверждает слияния сущностей и ведёт золотой датасет'
  }
  aiEngineer = techActor 'AI-инженер' {
    description 'Следит за метриками качества, промптами и регрессионными прогонами'
  }

  site = external 'Сайт интернет-магазина' {
    description 'Каталог и карточки товаров. Встраивает виджет и передаёт роль пользователя'
  }
  erp = external 'Учётная система' {
    description 'Остатки, заказы, сроки поставки'
  }
  priceFeed = external 'Канал прайсов поставщиков' {
    description 'Почта и личные кабинеты: прайсы и каталоги в XLSX и PDF'
  }

  platform = system 'Платформа товарных знаний' {
    description 'Отвечает на товарные вопросы, извлекая факты обходом графа знаний. Все модели исполняются внутри контура, обращений к внешним LLM-API нет'

    widget = webapp 'Виджет ассистента' {
      description 'Диалог на странице товара и в поиске. Публичный контур'
      technology 'TypeScript'
    }
    workplace = webapp 'Рабочее место сотрудника' {
      description 'Ответы, разбор прайсов, подтверждение слияний. Внутренний контур'
      technology 'TypeScript'
    }

    api = container 'API-шлюз' {
        description 'Аутентификация, определение роли, сессии, потоковая отдача ответа'
      technology 'Python, FastAPI'
    }
    agent = container 'Сервис агента' {
      description 'Конечный автомат обработки запроса: планирование, обход графа, самопроверка. Здесь же входные и выходные guardrails'
      technology 'Python, LangGraph'

      controller = component 'Контроллер запроса' {
        description 'Точка входа. Принимает запрос с ролью и разрешёнными грифами, отдаёт ответ потоком'
        technology 'FastAPI router'
      }
      guardIn = component 'Входные guardrails' {
        description 'Инъекции инструкций и маскирование ПДн до передачи в модель'
        technology 'Regex, NER, классификатор'
      }
      planner = component 'Планировщик' {
        description 'Конечный автомат: выбирает инструменты, решает о дополнительном шаге, ограничивает число итераций'
        technology 'LangGraph StateGraph'
      }
      vectorTool = component 'Инструмент векторного поиска' {
        description 'Поиск чанков. Фильтр по ACL входит в запрос, а не применяется к результату'
        technology 'Qdrant client'
      }
      graphTool = component 'Инструмент обхода графа' {
        description 'Многошаговые запросы по графу. Предикат ACL добавляется к каждому Cypher'
        technology 'Neo4j driver'
      }
      reranker = component 'Переранжировщик' {
        description 'Переупорядочивает кандидатов из графа и вектора перед подачей в контекст'
        technology 'Cross-encoder'
      }
      promptFactory = component 'Фабрика промптов' {
        description 'Собирает промпт из шаблона под роль и сценарий, подставляет извлечённые факты'
        technology 'Jinja2'
      }
      inferenceClient = component 'Клиент инференса' {
        description 'Обращение к сервису инференса, потоковая выдача токенов, ограничение контекста'
        technology 'OpenAI-совместимый клиент'
      }
      assembler = component 'Сборщик ответа' {
        description 'Проставляет ссылки на источники. Если подтверждающих узлов нет, формирует отказ вместо догадки'
        technology 'Python'
      }
      guardOut = component 'Выходные guardrails и аудит' {
        description 'Проверка утечки закрытых атрибутов и ПДн, запись в журнал обращений, отправка трасс'
        technology 'Python, OpenTelemetry'
      }

      controller -> guardIn 'Проверяет запрос'
      controller -> planner 'Запускает обработку'
      planner -> vectorTool 'Ищет чанки'
      planner -> graphTool 'Обходит граф'
      planner -> reranker 'Переранжирует кандидатов'
      planner -> promptFactory 'Собирает промпт'
      promptFactory -> inferenceClient 'Передаёт промпт'
      inferenceClient -> assembler 'Отдаёт токены'
      assembler -> guardOut 'Отдаёт ответ на проверку'
      guardOut -> controller 'Возвращает проверенный ответ'
    }
    ingestion = gpu 'Конвейер загрузки' {
        description 'Офлайн: разбор документов, распознавание сканов, извлечение сущностей, присвоение грифа. Требует GPU'
      technology 'Python'
    }

    inference = gpu 'Сервис инференса' {
        description 'Генерация ответа и построение эмбеддингов. Внутри контура, а не внешний провайдер. Требует GPU'
      technology 'vLLM или llama.cpp'
    }
    graphdb = storage 'Граф знаний' {
        description 'Product, Prototype, Party, Document. Метка ACL - обязательный атрибут узла'
      technology 'Neo4j'
    }
    vectordb = storage 'Векторное хранилище' {
        description 'Чанки с payload-фильтром по ACL, применяемым до ранжирования. Высокое потребление ОЗУ'
      technology 'Qdrant'
    }
    opdb = storage 'Служебная база' {
        description 'Сессии, аудит обращений, права, очередь позиций на подтверждение'
      technology 'PostgreSQL'
    }
    blobs = storage 'Хранилище документов' {
        description 'Оригиналы прайсов, каталогов и изображений'
      technology 'S3-совместимое'
    }

    observability = container 'Контур наблюдаемости' {
      description 'Трассы обработки запроса, метрики качества и потребления'
      technology 'OpenTelemetry, Prometheus, Grafana'
    }

    widget -> api '1. Запрос пользователя' 'HTTPS / JSON'
    workplace -> api '1. Запрос пользователя' 'HTTPS / JSON'
    api -> agent.controller '2. Передаёт запрос и разрешённые грифы' 'gRPC'

    // Права применяются как предикат запроса к хранилищу, а не постобработкой.
    agent.vectorTool -> vectordb '3. Поиск чанков с фильтром по ACL' 'gRPC'
    agent.graphTool -> graphdb '4. Обход графа с предикатом ACL' 'Bolt'
    agent.inferenceClient -> inference '5. Генерация ответа по извлечённым фактам' 'OpenAI-совместимый API'
    agent.guardOut -> opdb '6. Пишет аудит обращения' 'SQL'

    // Офлайн-конвейер: тяжёлая обработка вынесена из онлайн-пути.
    ingestion -> blobs 'Складывает оригиналы документов' 'S3 API'
    ingestion -> inference 'Строит эмбеддинги, распознаёт изображения' 'OpenAI-совместимый API'
    ingestion -> graphdb 'Создаёт узлы и связи, проставляет грифы' 'Bolt'
    ingestion -> vectordb 'Обновляет индекс чанков' 'gRPC'
    ingestion -> opdb 'Ставит позиции в очередь на подтверждение' 'SQL'

    api -> observability 'Отдаёт трассы и метрики' 'OTLP'
    agent -> observability 'Отдаёт трассы и метрики' 'OTLP'
    ingestion -> observability 'Отдаёт метрики конвейера' 'OTLP'
  }

  buyer -> platform.widget 'Задаёт вопрос о товаре' 'HTTPS'
  site -> platform.widget 'Встраивает виджет, передаёт роль пользователя' 'JS SDK'
  manager -> platform.workplace 'Спрашивает о товаре, получает ответ со ссылками на источники' 'HTTPS'
  procurer -> platform.workplace 'Загружает прайс, смотрит сопоставление с ассортиментом' 'HTTPS'
  expert -> platform.workplace 'Подтверждает слияния, пополняет золотой датасет' 'HTTPS'
  aiEngineer -> platform.observability 'Смотрит трассы и метрики качества' 'HTTPS'

  platform.api -> erp 'Запрашивает остатки и сроки' 'REST'
  platform.ingestion -> priceFeed 'Забирает прайсы и каталоги' 'IMAP / файловый обмен'
  platform.ingestion -> site 'Забирает каталог и карточки' 'REST / выгрузка'
}

views {
  view L3_Agent of agent {
    title 'Уровень 3. Компоненты сервиса агента'
    description 'Внутреннее устройство: guardrails, планировщик, инструменты извлечения, сборка ответа'
    include *
    include api, vectordb, graphdb, inference, opdb
  }

  // Динамические представления. Порядок шагов задаётся здесь и должен
  // совпадать с составом компонентов уровня 3: каждый компонент участвует
  // хотя бы в одном сценарии.
  // Сценарий 1 разбит на две фазы. Причина не косметическая: 17 линий жизни
  // в одной диаграмме нечитаемы, а граница между извлечением и генерацией
  // совпадает с фазами автомата.
  dynamic view Seq_Answer_1 {
    title 'Сценарий 1а. Приём запроса и извлечение фактов'
    description 'От вопроса покупателя до отранжированного набора фактов'

    buyer -> platform.widget 'Спрашивает про совместимость модели'
    platform.widget -> platform.api 'POST /v1/answer'
    platform.api -> platform.agent.controller 'Запрос, роль buyer, грифы [public]'
    platform.agent.controller -> platform.agent.guardIn 'Проверяет на инъекции и ПДн'
    platform.agent.guardIn -> platform.agent.controller 'Очищенный текст'
    platform.agent.controller -> platform.agent.planner 'Запускает автомат'
    platform.agent.planner -> platform.agent.vectorTool 'Ищет чанки'
    platform.agent.vectorTool -> platform.vectordb 'Поиск с фильтром acl=[public]'
    platform.agent.planner -> platform.agent.graphTool 'Обходит граф от найденных артикулов'
    platform.agent.graphTool -> platform.graphdb 'Cypher с предикатом acl'
    platform.agent.planner -> platform.agent.reranker 'Переранжирует кандидатов'
  }

  dynamic view Seq_Answer_2 {
    title 'Сценарий 1б. Генерация ответа и доставка'
    description 'От собранных фактов до ответа со ссылками на источники'

    platform.agent.planner -> platform.agent.promptFactory 'Собирает промпт из фактов'
    platform.agent.promptFactory -> platform.agent.inferenceClient 'Передаёт промпт'
    platform.agent.inferenceClient -> platform.inference 'Генерация, потоковая выдача'
    platform.agent.inferenceClient -> platform.agent.assembler 'Токены ответа'
    platform.agent.assembler -> platform.agent.guardOut 'Ответ со ссылками на артикулы'
    platform.agent.guardOut -> platform.opdb 'Пишет аудит'
    platform.agent.guardOut -> platform.agent.controller 'Проверенный ответ'
    platform.agent.controller -> platform.api 'Поток SSE'
    platform.api -> platform.widget 'Ответ со ссылками'
    platform.widget -> buyer 'Показывает ответ и источники'
  }

  dynamic view Seq_Denied {
    title 'Сценарий 2. Запрос данных вне уровня доступа'
    description 'Менеджер спрашивает о маржинальности. Отказ формируется отсутствием данных, а не проверкой после ответа'

    manager -> platform.workplace 'Какая маржа по этому бренду'
    platform.workplace -> platform.api 'POST /v1/answer'
    platform.api -> platform.agent.controller 'Запрос, роль manager, грифы [public, internal]'
    platform.agent.controller -> platform.agent.planner 'Запускает автомат'
    platform.agent.planner -> platform.agent.graphTool 'Обходит граф'
    platform.agent.graphTool -> platform.graphdb 'Cypher с предикатом acl=[public, internal]'
    platform.graphdb -> platform.agent.graphTool 'Ноль узлов: маржа имеет гриф confidential'
    platform.agent.planner -> platform.agent.assembler 'Подтверждающих узлов нет'
    platform.agent.assembler -> platform.agent.guardOut 'Отказ "нет данных" без упоминания причины'
    platform.agent.guardOut -> platform.opdb 'Пишет аудит и число отсечённых узлов'
    platform.agent.guardOut -> platform.agent.controller 'Отказ'
    platform.agent.controller -> platform.api 'Ответ без источников'
    platform.api -> platform.workplace 'Нет данных, предложить обратиться к закупщику'
  }

  // index - стартовое представление LikeC4. Если его не задать,
  // инструмент создаст своё, и уровень 1 продублируется.
  view index {
    title 'Уровень 1. Контекст'
    description 'Кто пользуется платформой и с чем она связана'
    include buyer, manager, procurer, expert, aiEngineer, platform, site, erp, priceFeed
  }

  view L2_Containers of platform {
    title 'Уровень 2. Контейнеры'
    description 'Разделение Control Plane и Data Plane, офлайн-конвейер загрузки'

    // group рисует рамку вокруг набора элементов. Задание требует именно
    // разделения плоскостей, а тег дал бы только подпись на элементе.
    //
    // Две особенности, которые легко потерять при правке:
    // 1. Элемент попадает в рамку, только если включён исключительно внутри
    //    группы. include * включил бы контейнеры раньше, и рамки остались бы
    //    пустыми.
    // 2. Группа заменяет собой границу системы, а не дополняет её. Поэтому
    //    плоскости вложены во внешнюю группу: иначе граница платформы
    //    исчезает, и виджет становится неотличим от внешнего сайта.
    group 'Платформа товарных знаний' {
      group 'Control Plane' {
        include api, agent, ingestion
      }
      group 'Data Plane' {
        include inference, graphdb, vectordb, opdb, blobs
      }
      include widget, workplace, observability
    }

    include buyer, manager, procurer, expert, aiEngineer, site, erp, priceFeed
  }
}
