%% Канареечный выпуск: ступени, условия перехода и сигналы отката.
%% Ступени считаются запросами, а не процентами: 1 процент трафика - 10 запросов в сутки.
%% Решения - ADR-0020, описание - docs/16-delivery-pipeline.md.
%% Пересборка: npx @mermaid-js/mermaid-cli -i delivery-canary.mmd -o delivery-canary.png -s 3 -b white
flowchart TB

  BUNDLE[("Реестр выпуска:<br/>четвёрка прошла оба гейта")]

  S0["Ступень 0. Тень<br/>копия трафика, ответы не отдаются<br/>200 запросов, окно аренды GPU"]
  S1["Ступень 1. Внутренний контур<br/>все сотрудники, публичного трафика нет<br/>не менее 100 запросов и 1 рабочий день"]
  S2["Ступень 2. Публичный контур, 5 процентов сессий<br/>не менее 200 запросов и 2 рабочих дня"]
  S3["Ступень 3. Публичный контур, 25 процентов сессий<br/>не менее 500 запросов и 2 рабочих дня"]
  S4["Ступень 4. Публичный контур, 100 процентов<br/>прежняя версия держится горячей 72 часа"]
  DONE["Выпуск завершён,<br/>прежняя версия выведена"]

  PROXY["Обратный прокси: вес ступени<br/>и закрепление сессии по хешу<br/>идентификатора диалога"]

  MON["Контроль на каждой ступени:<br/>канарейка против базы,<br/>одно и то же окно времени"]

  HARD{"Жёсткие сигналы, порог ноль:<br/>ответ без источника,<br/>утечка грифа,<br/>расхождение мажорной версии индекса"}
  SOFT{"Сравнение с базой:<br/>внутренние ошибки,<br/>доля отказов,<br/>ответы без сверки"}
  LAT{"Задержка p95 и вклад фаз:<br/>набирается от 200 запросов"}

  ROLL["Откат: вес канарейки в ноль.<br/>Код - прежний образ,<br/>индекс - обратная смена псевдонима"]
  HOLD["Удержание ступени:<br/>продвижение запрещено,<br/>откат не требуется"]

  BUNDLE --> S0 --> S1 --> S2 --> S3 --> S4 --> DONE
  PROXY -. "задаёт долю<br/>на ступенях 2 и 3" .-> S2
  S2 -. "сигналы снимаются<br/>на каждой ступени" .-> MON

  MON --> HARD
  MON --> SOFT
  MON --> LAT

  HARD -- "одно событие" --> ROLL
  SOFT -- "превышение над базой" --> ROLL
  SOFT -- "различие в пределах шума<br/>при малом числе запросов" --> HOLD
  LAT -- "выше бюджета 5 с" --> HOLD

  classDef stage fill:#eef4fb,stroke:#5b7fa6
  classDef gate fill:#fdf3e0,stroke:#b8863b
  classDef store fill:#e8f2e8,stroke:#5f8a5f
  classDef warn fill:#fbeeee,stroke:#a65b5b
  class S0,S1,S2,S3,S4,PROXY,MON,DONE stage
  class HARD,SOFT,LAT gate
  class BUNDLE store
  class ROLL,HOLD warn
